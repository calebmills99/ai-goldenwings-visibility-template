{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-goldenwings-visibility-template",
	"compatibility_date": "2025-10-08",
	"main": "./workers/app.ts",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "AEO_KV",
			"id": "19cd52d78e324f6ab99f3744526f1359"
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "secrets-store",
			"store_id": "ac10950b9f7940ea8af19285d93b39e9",
			"secret_name": "GEMINI_API_KEY"
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "brand-visibility-jobs",
				"binding": "BRAND_VISIBILITY_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "brand-visibility-jobs",
				"max_batch_size": 5,
				"max_concurrency": 10
			}
		]
	}
}
